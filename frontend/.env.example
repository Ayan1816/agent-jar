# AgentJar on chain ID 56. Leave empty until the contract is deployed.
# The app renders a configuration banner and disables writes while this is unset.
NEXT_PUBLIC_AGENTJAR_ADDRESS=

# Public read endpoints. Writes still require an explicit wallet confirmation.
NEXT_PUBLIC_BSC_RPC_URL=https://bsc-dataseed.binance.org
NEXT_PUBLIC_BSC_RPC_FALLBACK=https://bsc-rpc.publicnode.com

# Optional TipSent indexing start block. The app still caps the scanned window
# so a public RPC is not asked to walk the full chain.
# NEXT_PUBLIC_AGENTJAR_FROM_BLOCK=
